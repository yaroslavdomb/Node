{
  "name": "Testing BE",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "cross-env ENV_TYPE=dev dotenvx run -f src/config/.env.dev -- tsx watch -- src/index.ts",
    "dev_debug": "cross-env ENV_TYPE=dev dotenvx run -f src/config/.env.dev -- tsx watch --inspect -- src/index.ts",
    "prod": "pnpm build && cross-env ENV_TYPE=prod dotenvx run -f src/config/.env.prod -- node buildedProj/index.js",
    "postinstall": "node scripts/setup-env.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module"
}
