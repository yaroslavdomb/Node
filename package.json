{
  "name": "Testing BE",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "tests_view": "cross-env ENV_TYPE=test vitest run --reporter=verbose",
    "tests_watch": "cross-env ENV_TYPE=test vitest",
    "dev_nodemon": "cross-env ENV_TYPE=dev nodemon --exec tsx src/index.ts",
    "dev_watch": "cross-env ENV_TYPE=dev dotenvx run -f src/config/.env.dev -- tsx watch src/index.ts",
    "prod": "cross-env ENV_TYPE=prod dotenvx run -f src/config/.env.prod -- pm2 start src/index.ts --time --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "mysql2": "^3.24.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.0",
    "chalk": "^6.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "picocolors": "^1.1.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module"
}
