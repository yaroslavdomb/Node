{
  "name": "Testing BE",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "tests_view": "vitest run --reporter=verbose",
    "tests_watch": "vitest",
    "dev_nodemon": "nodemon --exec tsx src/index.ts",
    "dev_watch": "dotenvx run -f src/config/.env.dev -- tsx watch src/index.ts",
    "prod": "dotenvx run -f src/config/.env.prod -- pm2 start src/index.ts --time --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "mysql2": "^3.24.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "chalk": "^6.0.0",
    "nodemon": "^3.1.14",
    "picocolors": "^1.1.1",
    "pm2": "^7.0.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
}
