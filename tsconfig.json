{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./buildedProj",
    "strict": false,
    "strictNullChecks": true,
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,    
    "skipLibCheck": true,
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "src/tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "dist"
  ]
}