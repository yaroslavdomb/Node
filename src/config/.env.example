DB_HOST=localhost
DB_PORT=27017
DB_NAME=Nodejs_final_project
DB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<YOUR_MONGO_CLAUD_CLASTER>/
DB_INIT_TEST_DATA=true
DB_INIT_USERS=3
DB_INIT_CARDS=15
ENV_TYPE=dev
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_VALID_TIME=480min
JSON_BODY_LIMIT=2kb
LOG_LEVEL=debug
LOGIN_RETRY_LIMIT=5
LOGIN_WINDOW_DURATION=3600
LOGIN_BLOCK_DURATION=7200
SCHEMA=http
SERVER=localhost
SERVER_PORT=8050
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
FILE_LOG_ENABLED=true
FILE_LOG_SIZE=10m
FILE_LOG_PREFIX=nodeProject
FILE_LOG_DATA_NAMING_FORMAT=dd-MM-yyyy
FILE_LOG_MAX_NUMBER=10